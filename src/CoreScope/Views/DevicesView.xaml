<UserControl x:Class="CoreScope.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="clr-namespace:CoreScope.Core.Hardware">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="DEVICES" Style="{StaticResource Overline}" />
            <TextBlock Text="Everything connected to this PC" Style="{StaticResource Headline}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource SubHeadline}" />

            <ContentControl ContentTemplate="{StaticResource SkeletonCards}" Focusable="False"
                            Visibility="{Binding IsLoading, Converter={StaticResource Vis}}" />

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type hw:DeviceCategory}">
                        <Border x:Name="CategoryCard" Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CategoryGlyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="{StaticResource IconTitle}"
                                               Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding Note, Converter={StaticResource Vis}}" />

                                <ItemsControl ItemsSource="{Binding Devices}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type hw:DeviceEntry}">
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,12">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <!-- Status pill only for non-working devices -->
                                                        <Border x:Name="Pill" DockPanel.Dock="Right" Style="{StaticResource Pill}" Visibility="Collapsed">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource SevNeutral}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBlock x:Name="PillText" Text="Disabled" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                                       Visibility="{Binding Subtitle, Converter={StaticResource Vis}}" />
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Extra details (network adapters: IP, MAC, speed, Wi-Fi signal) -->
                                                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,8,0,0"
                                                                  Visibility="{Binding Details.Count, Converter={StaticResource Vis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type hw:SpecRow}">
                                                                <StackPanel Width="208" Margin="0,4,16,4">
                                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                                                    <TextBlock Text="{Binding Value}" Style="{StaticResource BodyText}"
                                                                               Typography.NumeralAlignment="Tabular" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding StatusName}" Value="Problem">
                                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SevCriticalTint}" />
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SevCritical}" />
                                                    <Setter TargetName="PillText" Property="Text" Value="Not working" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusName}" Value="Disabled">
                                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Title}" Value="Needs attention">
                                <Setter TargetName="CategoryCard" Property="BorderBrush" Value="{StaticResource SevCritical}" />
                                <Setter TargetName="CategoryGlyph" Property="Foreground" Value="{StaticResource SevCritical}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
