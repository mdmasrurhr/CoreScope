<UserControl x:Class="CoreScope.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoreScope.Core.ViewModels"
             xmlns:c="clr-namespace:CoreScope.Controls">
    <UserControl.Resources>
        <!-- One column definition shared by header and rows so they always line up -->
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,0" MaxWidth="{StaticResource PageMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SENSORS" Style="{StaticResource Overline}" />
            <DockPanel Margin="0,0,0,24">
                <Grid DockPanel.Dock="Right" Width="280" VerticalAlignment="Center">
                    <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="12,8"
                             AutomationProperties.Name="Filter sensors" />
                    <TextBlock Text="Filter sensors…" IsHitTestVisible="False" Margin="16,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource BodySecondary}"
                               Visibility="{Binding Filter, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                </Grid>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenRecordingsCommand}" ToolTip="Open Documents\CoreScope"
                            AutomationProperties.Name="Open recordings folder">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                    </Button>
                    <Button Command="{Binding RecordCommand}" Padding="16,8" MinWidth="96" AutomationProperties.Name="{Binding RecordButtonText}"
                            ToolTip="Saves every sensor once per refresh to a CSV file you can graph in Excel.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource SevCritical}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecordButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Live readings" Style="{StaticResource Headline}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{Binding RecordingText, Converter={StaticResource Vis}}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
            <StackPanel Margin="0,0,0,24">
                <!-- Empty state: filter matched nothing -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}"
                        Visibility="{Binding HasNoMatches, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ClearFilterCommand}" Content="Clear filter"
                                Padding="16,8" MinWidth="96" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="{StaticResource IconTitle}" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="No sensors match your filter" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Try a device name (e.g. Ryzen, NVMe) or a type (Temperature, Clock, Power)." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Skeleton until the first snapshot arrives -->
                <ContentControl ContentTemplate="{StaticResource SkeletonCards}" Focusable="False"
                                Visibility="{Binding Groups.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroupViewModel}">
                            <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}"
                                    Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}"
                                                   Foreground="{DynamicResource AccentText}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="168" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sensor" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource Caption}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Min" Style="{StaticResource Caption}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Max" Style="{StaticResource Caption}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="Last 60 s" Style="{StaticResource Caption}" Margin="24,0,0,0" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Sensors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SensorRowViewModel}">
                                                <Grid Margin="0,4" Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="168" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Type}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource NumberCell}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Min}" Style="{StaticResource NumberCell}"
                                                               FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Max}" Style="{StaticResource NumberCell}"
                                                               FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <c:SparkChart Grid.Column="4" Height="24" Margin="24,0,0,0" StrokeThickness="1.5"
                                                                  Data="{Binding Data}" Minimum="{Binding ScaleMin}" Maximum="{Binding ScaleMax}"
                                                                  Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
