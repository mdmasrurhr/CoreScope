<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ SDK projection: needed for the WinRT Radios API (Wi-Fi / Bluetooth switches). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon); WPF has no tray API. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Null-safety regressions fail the build; .NET analyzers are on. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CoreScope</RootNamespace>
    <AssemblyName>CoreScope</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(TestBuild)' == 'true'">app.test.manifest</ApplicationManifest>
    <DefineConstants Condition="'$(TestBuild)' == 'true'">$(DefineConstants);TESTBUILD</DefineConstants>
    <ApplicationIcon>Assets\CoreScope.ico</ApplicationIcon>
    <Product>CoreScope</Product>
    <Description>Hardware information, live sensors and plain-English insights for Windows PCs.</Description>
    <Version>1.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF0001: Fluent ThemeMode is marked experimental. CA1416: Windows-only APIs (this app is Windows-only). -->
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\CoreScope.ico" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\THIRD-PARTY-NOTICES.txt')" />
  </ItemGroup>

  <!-- Helper hook: if a ".package-request" file exists in the repo root, a normal publish also builds the
       self-contained distributable (tools\package.ps1 → dist\). Lets the unattended build helper make the package. -->
  <Target Name="CoreScopePackage" AfterTargets="Publish" Condition="'$(TestBuild)' != 'true' And Exists('$(MSBuildProjectDirectory)\..\..\.package-request')">
    <Delete Files="$(MSBuildProjectDirectory)\..\..\.package-request" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\package.ps1&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
  </Target>

  <!-- Same idea for the Microsoft Store package: ".msix-request" in the repo root → tools\msix\make-msix.ps1. -->
  <Target Name="CoreScopeMsix" AfterTargets="Publish" Condition="'$(TestBuild)' != 'true' And Exists('$(MSBuildProjectDirectory)\..\..\.msix-request')">
    <Delete Files="$(MSBuildProjectDirectory)\..\..\.msix-request" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\msix\make-msix.ps1&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
  </Target>

</Project>
