<UserControl x:Class="CoreScope.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoreScope.Core.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="BENCHMARK" Style="{StaticResource Overline}" />
            <TextBlock Text="How fast is this PC?" Style="{StaticResource Headline}" />
            <TextBlock Style="{StaticResource SubHeadline}"
                       Text="Short, repeatable tests for the processor, memory and system drive. Run before and after a change (new RAM, SSD, power mode) to see the difference." />

            <Border Style="{StaticResource Card}" Margin="{DynamicResource SectionGap}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" MinWidth="96">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,8,0" />
                            <TextBlock Text="Run benchmark" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource BodyStrong}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="The disk test writes a 512 MB temporary file to your temp folder and deletes it afterwards." />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding Rows.Count, Converter={StaticResource Vis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Test" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="Result" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="Previous run" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="3" Text="What it means" Style="{StaticResource Caption}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BenchmarkRow}">
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Metric}" Style="{StaticResource BodyText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyStrong}" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="2" Text="{Binding Previous}" Style="{StaticResource BodySecondary}" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="3" Text="{Binding Verdict}" Style="{StaticResource BodySecondary}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
