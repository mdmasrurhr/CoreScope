<UserControl x:Class="CoreScope.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="clr-namespace:CoreScope.Core.Hardware"
             xmlns:net="clr-namespace:CoreScope.Core.Network">
    <UserControl.Resources>
        <Style x:Key="TuningRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <!-- One column of the channel chart: bar height = how crowded the channel is -->
        <DataTemplate x:Key="ChannelBar" DataType="{x:Type net:ChannelLoad}">
            <StackPanel Width="32" Margin="0,0,4,0" ToolTip="{Binding Tooltip}">
                <Grid Height="72">
                    <Border x:Name="Bar" Height="72" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" MinHeight="2"
                            Background="{StaticResource SevNeutral}">
                        <Border.LayoutTransform>
                            <ScaleTransform ScaleY="{Binding Height}" />
                        </Border.LayoutTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="Label" Text="{Binding Channel}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource SevGood}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsYours}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="NETWORK" Style="{StaticResource Overline}" />
            <TextBlock Text="Is your internet working well?" Style="{StaticResource Headline}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource SubHeadline}" />

            <!-- ═════ Speed test ═════ -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource SectionGap}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Command="{Binding RunTestCommand}" IsEnabled="{Binding CanTest}" VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButton}" Padding="16,8" MinWidth="96" AutomationProperties.Name="Run speed test">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEC4A;" Margin="0,0,8,0" />
                                <TextBlock Text="Run speed test" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Speed and ping" Style="{StaticResource TitleText}" />
                            <TextBlock Text="Downloads test data for about 10 seconds and pings your router and the internet. Uses roughly 50–500 MB depending on your speed."
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Download" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource MetricValue}" FontSize="{DynamicResource FontDisplay}" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding SpeedDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Ping to router" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RouterText}" Style="{StaticResource BodyStrong}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Should be under 10 ms" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ping to internet" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding InternetText}" Style="{StaticResource BodyStrong}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Under 40 ms is great for games and calls" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsTesting, Converter={StaticResource Vis}}">
                        <ProgressBar IsIndeterminate="True" Height="4" />
                        <TextBlock Text="{Binding TestStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Result of the last fix -->
            <Border Style="{StaticResource Inset}" Margin="{DynamicResource CardGap}" Visibility="{Binding FixMessage, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Margin="0,2,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                <Setter Property="Text" Value="&#xE73E;" />
                                <Setter Property="Foreground" Value="{StaticResource SevGood}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FixOk}" Value="False">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{StaticResource SevWarning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FixMessage}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- ═════ Findings (with one-click fixes) ═════ -->
            <TextBlock Text="Findings" Style="{StaticResource SectionTitle}" Margin="0,8,0,12" />
            <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource InsightTemplate}" KeyboardNavigation.TabNavigation="Continue" />

            <!-- ═════ Wi-Fi analyzer ═════ -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ScanWifiCommand}" AutomationProperties.Name="Scan nearby Wi-Fi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,8,0" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Nearby Wi-Fi" Style="{StaticResource TitleText}" />
                            <TextBlock Text="{Binding WifiSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding WifiSummary, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding IsScanningWifi, Converter={StaticResource Vis}}" />

                    <!-- Problem (e.g. Location off) -->
                    <DockPanel Visibility="{Binding WifiProblem, Converter={StaticResource Vis}}" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Open Location settings" Command="{Binding OpenLocationSettingsCommand}" Padding="16,8" VerticalAlignment="Center"
                                Visibility="{Binding WifiNeedsLocation, Converter={StaticResource Vis}}" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding WifiProblem}" Style="{StaticResource BodySecondary}" TextWrapping="Wrap" />
                    </DockPanel>

                    <!-- Recommendation -->
                    <Border Style="{StaticResource Inset}" Margin="0,4,0,12" Visibility="{Binding WifiRecommendation, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock x:Name="RecGlyph" DockPanel.Dock="Left" Margin="0,2,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{StaticResource SevGood}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WifiCrowded}" Value="True">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{StaticResource SevWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding WifiRecommendation}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Channel charts -->
                    <StackPanel Visibility="{Binding HasWifi, Converter={StaticResource Vis}}">
                        <WrapPanel>
                            <StackPanel Margin="0,0,32,12" Visibility="{Binding Channels24.Count, Converter={StaticResource Vis}}">
                                <TextBlock Text="2.4 GHz channels" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Channels24}" ItemTemplate="{StaticResource ChannelBar}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding Channels5.Count, Converter={StaticResource Vis}}">
                                <TextBlock Text="5 GHz channels" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Channels5}" ItemTemplate="{StaticResource ChannelBar}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Your router" Style="{StaticResource Caption}" Margin="6,0,16,0" />
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource SevGood}" VerticalAlignment="Center" />
                            <TextBlock Text="Least crowded" Style="{StaticResource Caption}" Margin="6,0,16,0" />
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource SevNeutral}" VerticalAlignment="Center" />
                            <TextBlock Text="Other networks (taller = busier)" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                        </StackPanel>

                        <!-- Network list -->
                        <ItemsControl ItemsSource="{Binding NearbyNetworks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type net:WifiNetwork}">
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                                <Border x:Name="YoursPill" Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="8,2" Visibility="Collapsed">
                                                    <TextBlock Text="You" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Where}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <DockPanel Grid.Column="2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Signal, StringFormat={}{0}%}" Style="{StaticResource Caption}" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
                                                <ProgressBar Value="{Binding Signal}" Maximum="100" Height="4" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsYours}" Value="True">
                                            <Setter TargetName="YoursPill" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═════ Connection details ═════ -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RescanCommand}" AutomationProperties.Name="Refresh connection details">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,8,0" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Your connection" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Connection}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type hw:SpecRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource BodySecondary}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═════ Advanced tuning ═════ -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                <StackPanel>
                    <TextBlock Text="Advanced fixes" Style="{StaticResource TitleText}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap"
                               Text="Windows settings that commonly cause a strong signal but slow internet. Changing RSC and auto-tuning needs full access (Unlock full sensors)." />

                    <DockPanel Style="{StaticResource TuningRow}">
                        <Button DockPanel.Dock="Right" Command="{Binding ToggleRscCommand}" Content="{Binding RscButtonText}" Padding="16,8" MinWidth="96" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource BodyStrong}">
                                <Run Text="Receive Segment Coalescing (RSC):" /> <Run Text="{Binding RscText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Saves a little CPU by bundling incoming data. Some Wi-Fi drivers (often Realtek) download very slowly with it on. Turning it off is safe." />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource TuningRow}">
                        <Button DockPanel.Dock="Right" Command="{Binding AutoTuningNormalCommand}" Content="Set to normal" Padding="16,8" MinWidth="96" VerticalAlignment="Center"
                                Visibility="{Binding AutoTuningIsNormal, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource BodyStrong}">
                                <Run Text="TCP auto-tuning:" /> <Run Text="{Binding AutoTuningText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Lets Windows grow its download window for fast connections. Normal is right for almost everyone." />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding FlushDnsCommand}" Content="Clear" Padding="16,8" MinWidth="96" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="DNS cache" Style="{StaticResource BodyStrong}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Clears saved website addresses. Helps when one site won't load but others do." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
