<UserControl x:Class="CoreScope.Views.UpgradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="clr-namespace:CoreScope.Core.Hardware">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type hw:SpecRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource BodySecondary}" Margin="0,0,12,0" />
                <!-- Long values read as one line plus a small caption (model number, rating) -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Main}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Look-up links are ghost buttons: secondary emphasis, accent text, fill on hover -->
        <DataTemplate x:Key="LinkTemplate" DataType="{x:Type hw:UpgradeLink}">
            <Button Command="{Binding OpenCommand}" Style="{StaticResource GhostButton}" Margin="0,0,4,4" ToolTip="{Binding Url}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="{StaticResource IconSmall}" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
                <TextBlock Text="UPGRADE GUIDE" Style="{StaticResource Overline}" />
                <TextBlock Text="{Binding MachineName}" Style="{StaticResource Headline}" />
                <TextBlock Text="{Binding MachineDetail}" Style="{StaticResource SubHeadline}" />

                <!-- Primary action + look-ups -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource SectionGap}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CopyCommand}" VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}" Padding="16,8" MinWidth="96">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Margin="0,0,8,0" />
                                    <TextBlock Text="Copy shopping list" />
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="What can be upgraded, and exactly what to buy" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="Detected from firmware tables and device data. Anything software can't see is marked, with a link to look it up for your exact model." />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkTemplate}" Margin="-12,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ContentControl ContentTemplate="{StaticResource SkeletonCards}" Focusable="False"
                                Visibility="{Binding Items.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />

                <!-- One card per component -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type hw:UpgradeItem}">
                            <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- Status pill: tinted fill + colored dot, theme text color for contrast -->
                                        <Border x:Name="Pill" DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource SevNeutral}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="{StaticResource IconTitle}"
                                                   Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding Component}" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" Margin="0,8,0,16" />

                                    <!-- Context first, action last: what you have, then what to buy, full width so long values
                                         never squeeze (two columns can't balance 3 rows against 9). Soldered / not-upgradeable
                                         parts start collapsed because there is nothing to buy. -->
                                    <Expander x:Name="Details" Header="Specs and what to buy" IsExpanded="True" Padding="0,8,0,0"
                                              BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                        <StackPanel>
                                            <Border Padding="16,12" CornerRadius="{DynamicResource RadiusSmall}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="YOU HAVE" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding Current}" ItemTemplate="{StaticResource RowTemplate}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="16,12" Margin="0,12,0,0" CornerRadius="{DynamicResource RadiusSmall}"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Visibility="{Binding Buy.Count, Converter={StaticResource Vis}}">
                                                <StackPanel>
                                                    <TextBlock Text="WHAT TO BUY" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding Buy}" ItemTemplate="{StaticResource RowTemplate}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,12,0,0"
                                                  Visibility="{Binding Notes.Count, Converter={StaticResource Vis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="{StaticResource IconSmall}"
                                                               VerticalAlignment="Top" Margin="0,4,8,0" Foreground="{StaticResource SevInfo}" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource BodySecondary}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkTemplate}" Margin="-12,8,0,-4"
                                                  Visibility="{Binding Links.Count, Converter={StaticResource Vis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding StatusName}" Value="Upgradeable">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SevGoodTint}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SevGood}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusName}" Value="Partial">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SevInfoTint}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SevInfo}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusName}" Value="NotUpgradeable">
                                    <Setter TargetName="Details" Property="IsExpanded" Value="False" />
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SevCriticalTint}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SevCritical}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Micro-interaction: "Copied" toast slides up and fades in (200 ms), auto-hides after 2.5 s -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"
                Padding="16,12" CornerRadius="{DynamicResource RadiusCard}" IsHitTestVisible="False" Opacity="0"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.RenderTransform>
                <TranslateTransform Y="12" />
            </Border.RenderTransform>
            <Border.Effect>
                <!-- Floating element: stronger elevation than cards, but soft (low opacity, high blur) -->
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Direction="270" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE930;" Foreground="{StaticResource SevGood}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CopyStatus}" Style="{StaticResource BodyStrong}" />
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowCopyToast}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="12" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
