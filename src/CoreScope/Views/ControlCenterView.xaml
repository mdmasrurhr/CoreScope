<UserControl x:Class="CoreScope.Views.ControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CoreScope.Core.ViewModels">
    <UserControl.Resources>
        <!-- Label column + control column, shared by every settings row -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="224" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="CardHeader" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
                <TextBlock Text="CONTROL CENTER" Style="{StaticResource Overline}" />
                <TextBlock Text="Tune your PC" Style="{StaticResource Headline}" />
                <TextBlock Style="{StaticResource SubHeadline}"
                           Text="Changes go straight to Windows. Anything with a real impact asks first, and every change can be undone for 15 seconds." />

                <!-- ═════ Display ═════ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="{StaticResource IconTitle}" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                            <TextBlock Text="Display" Style="{StaticResource TitleText}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DisplayItemViewModel}">
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyStrong}" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Resolution" Style="{StaticResource RowLabel}" />
                                            <ComboBox Grid.Column="1" Style="{StaticResource Field}" ItemsSource="{Binding Resolutions}"
                                                      SelectedItem="{Binding Resolution, Mode=TwoWay}" AutomationProperties.Name="Resolution" />
                                            <TextBlock Grid.Row="1" Text="Refresh rate" Style="{StaticResource RowLabel}" Margin="0,8,0,0" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Margin="0,8,0,0"
                                                      ItemsSource="{Binding RefreshRates}" ItemStringFormat="{}{0} Hz"
                                                      SelectedItem="{Binding Refresh, Mode=TwoWay}" AutomationProperties.Name="Refresh rate" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Visibility="{Binding HasBrightness, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Brightness" Style="{StaticResource RowLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                                    VerticalAlignment="Center" AutomationProperties.Name="Brightness"
                                    Value="{Binding Brightness, Mode=TwoWay, Delay=350}" />
                            <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0}%}" Style="{StaticResource RowLabel}"
                                       TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═════ Power ═════ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="{StaticResource IconTitle}" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                            <TextBlock Text="Power &amp; performance" Style="{StaticResource TitleText}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Power mode" Style="{StaticResource RowLabel}" Visibility="{Binding HasPowerMode, Converter={StaticResource Vis}}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Field}" ItemsSource="{Binding PowerModes}" SelectedItem="{Binding PowerMode, Mode=TwoWay}"
                                      Visibility="{Binding HasPowerMode, Converter={StaticResource Vis}}" AutomationProperties.Name="Power mode">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PowerModeOption}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Power plan" Style="{StaticResource RowLabel}" Margin="0,12,0,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Margin="0,12,0,0"
                                      ItemsSource="{Binding Plans}" DisplayMemberPath="Name" SelectedItem="{Binding Plan, Mode=TwoWay}" AutomationProperties.Name="Power plan" />

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" Visibility="{Binding HasBoost, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding BoostEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="CPU boost" />
                                    <StackPanel>
                                        <TextBlock Text="CPU boost" Style="{StaticResource BodyStrong}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="Lets the CPU run above its base clock in bursts. Turning it off makes the PC cooler and quieter and extends battery life." />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Timeouts: plugged in vs on battery -->
                        <TextBlock Text="SCREEN &amp; SLEEP" Style="{StaticResource Overline}" Margin="0,24,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Plugged in" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="On battery" Style="{StaticResource Caption}" Visibility="{Binding HasBattery, Converter={StaticResource Vis}}" />

                            <TextBlock Grid.Row="1" Text="Turn screen off after" Style="{StaticResource RowLabel}" Margin="0,8,0,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Margin="0,8,16,0" ItemsSource="{Binding Timeouts}"
                                      SelectedItem="{Binding ScreenOffPluggedIn, Mode=TwoWay}" AutomationProperties.Name="Screen off when plugged in" />
                            <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" Margin="0,8,0,0" ItemsSource="{Binding Timeouts}"
                                      SelectedItem="{Binding ScreenOffOnBattery, Mode=TwoWay}" AutomationProperties.Name="Screen off on battery"
                                      Visibility="{Binding HasBattery, Converter={StaticResource Vis}}" />

                            <TextBlock Grid.Row="2" Text="Sleep after" Style="{StaticResource RowLabel}" Margin="0,8,0,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Margin="0,8,16,0" ItemsSource="{Binding Timeouts}"
                                      SelectedItem="{Binding SleepPluggedIn, Mode=TwoWay}" AutomationProperties.Name="Sleep when plugged in" />
                            <ComboBox Grid.Row="2" Grid.Column="2" Style="{StaticResource Field}" Margin="0,8,0,0" ItemsSource="{Binding Timeouts}"
                                      SelectedItem="{Binding SleepOnBattery, Mode=TwoWay}" AutomationProperties.Name="Sleep on battery"
                                      Visibility="{Binding HasBattery, Converter={StaticResource Vis}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═════ Battery care ═════ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}" Visibility="{Binding HasBattery, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE83F;" FontSize="{StaticResource IconTitle}" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                            <TextBlock Text="Battery care" Style="{StaticResource TitleText}" />
                        </DockPanel>
                        <ContentControl Content="{Binding Conservation}" ContentTemplate="{StaticResource SwitchRowTemplate}" Focusable="False"
                                        Visibility="{Binding HasConservation, Converter={StaticResource Vis}}" />
                        <TextBlock Style="{StaticResource BodySecondary}" Visibility="{Binding HasConservation, Converter={StaticResource Vis}, ConverterParameter=invert}"
                                   Text="A charge limit isn't controllable from here on this PC. Most makers offer it in their own app (Lenovo Vantage, MyASUS, Dell Power Manager, HP Smart, Surface app)." />
                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,12,0,0" Margin="0,12,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding BatteryReportCommand}" Content="Create report" Padding="16,8" MinWidth="96" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Battery report" Style="{StaticResource BodyStrong}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Windows' detailed history: capacity over time, charge cycles, usage and estimated battery life." />
                                    <TextBlock Text="{Binding BatteryReportStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding BatteryReportStatus, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═════ Radios & sound ═════ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE701;" FontSize="{StaticResource IconTitle}" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                            <TextBlock Text="Wireless &amp; sound" Style="{StaticResource TitleText}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Radios}" ItemTemplate="{StaticResource SwitchRowTemplate}" />

                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,12,0,0"
                                Visibility="{Binding HasAudio, Converter={StaticResource Vis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" Style="{StaticResource RowLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" VerticalAlignment="Center"
                                        AutomationProperties.Name="Volume" Value="{Binding Volume, Mode=TwoWay, Delay=350}" />
                                <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}" Style="{StaticResource RowLabel}"
                                           TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="24,0,0,0">
                                    <TextBlock Text="Mute" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Muted, Mode=TwoWay}" AutomationProperties.Name="Mute" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═════ Fans (only when the motherboard exposes controllable fans) ═════ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}" Visibility="{Binding HasFans, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE9CA;" FontSize="{StaticResource IconTitle}" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Fans" Style="{StaticResource TitleText}" />
                                <TextBlock Text="{Binding FanNames}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mode" Style="{StaticResource RowLabel}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Field}" ItemsSource="{Binding FanModes}" SelectedItem="{Binding FanMode, Mode=TwoWay}" AutomationProperties.Name="Fan mode" />
                            <TextBlock Grid.Row="1" Text="Fixed speed" Style="{StaticResource RowLabel}" Margin="0,12,0,0" Visibility="{Binding IsFixedFan, Converter={StaticResource Vis}}" />
                            <Slider Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Minimum="20" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                                    Value="{Binding FanPercent, Mode=TwoWay, Delay=350}" Visibility="{Binding IsFixedFan, Converter={StaticResource Vis}}" AutomationProperties.Name="Fan speed" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Text="{Binding FanPercent, StringFormat={}{0}%}" Style="{StaticResource RowLabel}" TextAlignment="Right"
                                       Visibility="{Binding IsFixedFan, Converter={StaticResource Vis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                   Text="Fans return to automatic (BIOS) control whenever CoreScope exits. Laptop fans are managed by the laptop's own controller and can't be set here." />
                    </StackPanel>
                </Border>

                <!-- ═════ Devices ═════ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}" Visibility="{Binding Devices.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE772;" FontSize="{StaticResource IconTitle}" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Devices" Style="{StaticResource TitleText}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="Turn individual devices off (like Device Manager's 'Disable device'). Keyboards, screens, storage and system devices are never offered." />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource SwitchRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- ═════ Startup apps ═════ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B5;" FontSize="{StaticResource IconTitle}" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Startup apps" Style="{StaticResource TitleText}" />
                                <TextBlock Text="{Binding StartupSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding StartupItems}" ItemTemplate="{StaticResource SwitchRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- ═════ Everything else: straight into the right Windows Settings page ═════ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="{StaticResource IconTitle}" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="More in Windows Settings" Style="{StaticResource TitleText}" />
                                <TextBlock Text="Opens the exact Settings page for things Windows only lets its own app change." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SettingsLinks}" Margin="-12,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingsLink}">
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" ToolTip="{Binding Uri}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═════ Change history (this session) ═════ -->
                <Border Style="{StaticResource Card}" Visibility="{Binding History.Count, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Changes this session" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,4" Typography.NumeralAlignment="Tabular" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════ Confirm / undo bar (pinned to the bottom) ═════ -->
        <StackPanel Grid.Row="1" Margin="32,0,32,16" MaxWidth="{StaticResource PageMaxWidth}">
            <!-- 1) Confirm before applying -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2"
                    Visibility="{Binding HasPending, Converter={StaticResource Vis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,8" MinWidth="96" Margin="0,0,8,0" />
                        <Button Content="Apply" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" MinWidth="96" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PendingTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding PendingDetail}" Style="{StaticResource BodySecondary}" Margin="0,4,0,0"
                                   Visibility="{Binding PendingDetail, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2) Applying… -->
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="{Binding IsApplying, Converter={StaticResource Vis}}" />

            <!-- 3) Undo window / display keep-or-revert -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding UndoText, Converter={StaticResource Vis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Keep" Command="{Binding KeepCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" MinWidth="96" Margin="0,0,8,0"
                                Visibility="{Binding IsAutoRevert, Converter={StaticResource Vis}}" />
                        <Button Command="{Binding UndoCommand}" Padding="16,8" MinWidth="96"
                                Visibility="{Binding HasUndo, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" Margin="0,0,8,0" />
                                <TextBlock Text="Undo" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE930;" Foreground="{StaticResource SevGood}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding UndoText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
