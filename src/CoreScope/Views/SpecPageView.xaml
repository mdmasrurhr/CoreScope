<UserControl x:Class="CoreScope.Views.SpecPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CoreScope.Controls"
             xmlns:hw="clr-namespace:CoreScope.Core.Hardware">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Overline}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Headline}" />
            <TextBlock Text="{Binding SubHeadline}" Style="{StaticResource SubHeadline}" />

            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Margin="0,0,-12,12"
                          Visibility="{Binding Tiles.Count, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- One row, equal-width tiles that fill the page width -->
                        <c:AdaptiveGrid MinItemWidth="176" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Slot diagram (RAM / M.2) -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}" Visibility="{Binding Slots.Count, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SlotsTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type hw:SlotVisual}">
                                <Grid Width="200" MinHeight="88" Margin="0,0,12,12">
                                    <Rectangle x:Name="Outline" RadiusX="8" RadiusY="8" StrokeThickness="1.5"
                                               Stroke="{DynamicResource AccentFillColorDefaultBrush}" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Border x:Name="Edge" Height="4" VerticalAlignment="Top" CornerRadius="8,8,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel Margin="12,12,12,10">
                                        <DockPanel>
                                            <TextBlock x:Name="Icon" DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE964;" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="StateText" Text="{Binding StateText}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding StateName}" Value="Empty">
                                        <Setter TargetName="Outline" Property="StrokeDashArray" Value="4 3" />
                                        <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource SevGood}" />
                                        <Setter TargetName="Outline" Property="Fill" Value="Transparent" />
                                        <Setter TargetName="Edge" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource SevGood}" />
                                        <Setter TargetName="Icon" Property="Text" Value="&#xE710;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateName}" Value="Soldered">
                                        <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource SevNeutral}" />
                                        <Setter TargetName="Edge" Property="Background" Value="{StaticResource SevNeutral}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Setter TargetName="Icon" Property="Text" Value="&#xE950;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateName}" Value="Unknown">
                                        <Setter TargetName="Outline" Property="StrokeDashArray" Value="2 3" />
                                        <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource SevNeutral}" />
                                        <Setter TargetName="Edge" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Setter TargetName="Icon" Property="Text" Value="&#xE9CE;" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SlotsNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding SlotsNote, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" />

            <!-- Skeleton while the hardware scan runs -->
            <ContentControl ContentTemplate="{StaticResource SkeletonCards}" Focusable="False"
                            Visibility="{Binding IsLoading, Converter={StaticResource Vis}}" />

            <!-- Empty state: scan finished but nothing was found -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="No details available" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodySecondary}" Margin="0,4,0,0"
                               Text="Windows didn't report anything for this component. Running CoreScope as administrator usually fixes this; the System page shows where the log file is." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
